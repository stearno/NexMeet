# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# NextAuth — generate secret with: openssl rand -hex 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://nexmeet.process4highroi.com

# Admin login credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public app URL (used in booking links and calendar event descriptions)
APP_URL=https://nexmeet.process4highroi.com

# Composio API key (for Google Calendar integration)
COMPOSIO_API_KEY=
